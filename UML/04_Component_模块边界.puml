@startuml 04_Component_模块边界
' ============================================================
'  模块边界图（contract-first）
'  目的：把"系统中心"从 JarSystem 门面，改为"核心 + 契约产物 + 多宿主/多客户端"。
'  依据：重构报告/10_模块边界与规范化升级路线.md（决策与出处）
'  实线 = 已存在；虚线 = 规划中/未落地（见 10_*.md 的 P0–P6）
' ============================================================

skinparam componentStyle rectangle
skinparam shadowing false
left to right direction

actor "用户" as User

package "陶罐系统（本仓库）" {

  component "JarSystem.Core\n（零外部依赖）" as Core {
    [Domain\nJar / Workshop / Order] as Domain
    [Solver\nStateSpaceSolver\n(DFS + 2^N 划分)] as Solver
    [Feasibility\n责任链 + PartitionSearch] as Feas
    [Executor\nOrderExecutor + 策略] as Exec
    [Services\n门面用例 + HTTP无关序列化] as Svc
    Domain --> Solver
    Feas --> Solver
    Exec --> Domain
    Svc --> Feas
  }

  artifact "contracts/\nstate.schema.json\n（9 类型 / JsonSchemaExporter 生成）" as Schema
  artifact "_contract/state_keys.txt\n（165 行文本基线，含路径键）" as Snapshot

  component "Web 宿主\n（ASP.NET Core minimal API\n+ 裸 WebSocket）" as Web
  component "CLI / 实验宿主\nStrategyExperiment" as Cli
  component "Godot 宿主\n（规划：直接引用 Core 程序集）" as Godot

  component "浏览器客户端\n原生 JS（现）→ Vite + TS（P4-c）" as Browser
  component "Godot 客户端\n（规划）" as GClient

  component "验证模块" as Test {
    [JarSystem.Test\n自定义 runner\n2000+3000+20] as T1
    [契约快照 + Schema 导出] as T2
    [xUnit v3 + FsCheck + Verify\n（P2/P3，规划）] as T3
  }

  artifact "config/world.json\n（S3b 已落地：形状/液体/容量/流入/\n生产者/库存/工作台清单/名字池）" as Rules
  artifact "契约校验\nWorldOptions.Validate()\n（Errors ⇒ 宿主拒绝启动）" as WorldCheck

  Cloud "Markdown 报告 / UML" as Docs
}

' ---- 核心 → 契约（产物，而不是口头约定）----
Core --> Schema : 生成（--dump-schema）
Core --> Snapshot : 投影（--dump-contract）
Core <.. Rules : 装配（S3b 已落地：宿主读文件 → WorldOptions → Validate）
Rules ..> WorldCheck : 校验失败即拒绝启动

' ---- 主机（宿主层才允许依赖框架与容器）----
Web --> Core : 引用程序集
Cli --> Core : 引用程序集
Godot --> Core : 引用程序集
Web --> Browser : 静态文件 + WS
Godot --> GClient : 场景/信号

' ---- 客户端只通过契约耦合 ----
Schema ..> Browser : 生成类型（P4-c）
Schema ..> GClient : 生成类型（规划）
Browser --> Web : {type,data} 消息（18 命令 / 9 消息）
GClient ..> Godot : 同契约

' ---- 验证模块消费同一份契约 ----
Test --> Core
Test --> Schema
Test --> Snapshot

User --> Browser
User --> Godot

Docs ..> Core : 记录（人工同步；长期改为生成/校验）

' ============================================================
'  明确"不引入"的东西（决策有据，见 10_*.md §3.1/§3.5/§6）
' ============================================================
note bottom of Web
  **不迁 SignalR**：官方 AOT 表 WebSockets ✔️ / SignalR partial；
  卖点（降级传输/backplane/群组/IHubContext）在本场景为空集，
  代价是 9 类消息全部重映射。
  **缺口只需**：前端补断线重连（T1）。
end note

note bottom of Solver
  **不用 OR-Tools / CP-SAT**：目标框架仅 net8.0、
  非纯托管（runtime.* 原生库、无 win-arm64）、默认可多线程+时间预算
  ⇒ 破坏确定性；路径还要自己回放。
  **不用规则引擎**：规则=纯函数 + 规则表数据。
  该补的是：置换表 + 迭代加深 + 固定转移顺序。
end note

note top of Core
  Core 只允许 .NET 基类库；
  **不引 Hosting / DI 容器 / IServiceProvider**
  （保住"可直接被 Godot/Unity 引用"这一核心资产）。
end note

note bottom of Test
  **保留**旧 runner 作"基线守护"：
  断言输出仍含
  `0 bugs / 2000 random + 0 bugs / 3000 capacity + 20 deterministic`
end note

@enduml
