@startuml
title JarSystem.Core 包分层与依赖方向（2026-11 第 3 版：层序表驱动）
' ============================================================
'  本版重写的理由：2026-10 之后做了「依赖分层治理」，层序被压成一条链、
'  双向环从 7 降到 0，并且若干类型**换了所属层**。旧图里这三条已不成立：
'    ① Orders.Feasibility / Orders.Switching / Executor 的子包切分（现按层排）
'    ② 「Domain 依赖 Services」这处味道（IIdGenerator 等已下沉到 Domain）
'    ③ 「Abstractions 与 Solver/Orders 互相引用」这处味道（契约值词汇已归 Abstractions）
'
'  层序表的唯一权威在代码里：test/JarSystem.Tests/ArchitectureTests.cs
'  规则：一个层只许引用**更低**的层；新增命名空间必须登记进表，否则测试红。
' ============================================================
skinparam shadowing false
skinparam packageStyle rectangle

package "L0 Config（常量与契约词汇）" as L0 {
  component "Constants（SHAPES / LIQUIDS / 操作名 / 订单状态）" as C0a
  component "Vocabulary / NamePoolOptions / WorkshopOptions / WorldOptions" as C0b
  component "CheckMethod / OrderType / OrderPhase / SwitchCaseType / OperationType" as C0c
  component "ShapeRules / Rules / OrderTemplateOptions / RequirementOptions" as C0d
}

package "L1 Domain（自身不依赖任何上层）" as L1 {
  component "Jar + JarPool（对象池 / 回收标记）" as D1a
  component "Workshop + WorkshopSnapshot + WorkshopCapability" as D1b
  component "RuleContext / ModifierStack / 5 种 Modifier" as D1c
  component "WorkshopRulebook / WorkshopOperation / JarFacts" as D1d
  component "IIdGenerator / SequentialIdGenerator / DefaultIdGenerators" as D1e
  component "IIntensitySource / DomainValidationException" as D1f
}

package "L2 Abstractions（跨层契约与值词汇）" as L2 {
  component "ISolver / IWorkBudgetedSolver" as A1
  component "SolverContracts：Requirement / JarState / SolverResult / WorkshopInfo…" as A2
  component "ICommandJournal / ISystemLog / ConsoleSystemLog / LogError" as A3
  component "IJarSelectionStrategy / IProcessRecorder / PlanSources / SolverLimits" as A4
}

package "L3 Rules（世界规则：查询 / 场景 / 装饰求解器）" as L3 {
  component "WorldQuery + IWorldFacts（结构化查询）" as R1
  component "IWorldEventSource + WorldEvent / EventData" as R2
  component "ScenarioOptions / ScenarioJson / ScenarioBinder / ModifierData" as R3
  component "ModifierAwareSolver（装饰器：可表达则投影，否则未判定）" as R4
}

package "L4 Production（产线 → 仓库 → 主台）" as L4 {
  component "ProducerModule / Producer / ShapeProductionLine" as P1
  component "Warehouse（StoreJars / ProduceLiquid / FlowToMaster）" as P2
}

package "L5 Solver（可行性求解：三种实现 + 一个前置检查）" as L5 {
  component "SolverPrecheck（只证不可行）" as S1
  component "PrecheckedStateSpaceSolver（默认装配）" as S2
  component "StateSpaceSolver（DFS + 记忆化）" as S3
  component "MatchingSolver（分配形，非默认）" as S4
}

package "L6 Commands（四个原子罐操作）" as L6 {
  component "Command / CommandResult / CommandExecutor" as M1
  component "PourIn / PourOut / ReshapeEmpty / Transfer 命令" as M2
}

package "L7 Orders（订单、执行语义、可行性、换台）" as L7 {
  component "Order / OrderEvent / ExecutionLogEntry / SlaveRollback" as O1
  component "OrderTemplate / OrderTemplateLibrary" as O2
  component "FeasibilityChecker / PartitionSearch / JarMatcher / RequirementOrdering" as O3
  component "WorkshopSwitchEvent + SwitchCases + ResourceTransferrer" as O4
  component "JarStateMapper / IProcessStepPrimitives" as O5
}

package "L8 Process（过程：状态机 / 日志 / 调度 / 端口）" as L8 {
  component "Model：ProcessDefinition / Instance / Run / State" as PR1
  component "Scheduler：WorldScheduler / ITickHandler / TickPhase / TickPipeline / LogicalClock" as PR2
  component "Ports：IProcessAdvancer / IProcessObserver / IOrderExecutionCompletion" as PR3
  component "Journal：ProcessJournal / JournalCodec" as PR4
  component "Execution：OrderExecutionSession / SwitchProcessAdvancer" as PR5
  component "ProcessSystem（门面）" as PR6
}

package "L9 Services（状态序列化与服务层）" as L9 {
  component "StateDto / StateSerializer + 10 个 DTO" as V1
  component "WorkshopService / OrderService / ProductionService" as V2
  component "MasterSwitchCoordinator" as V3
}

package "L10 Sessions（命令日志与回放）" as L10 {
  component "WorldCommand / WorldOps / WorkshopPayload / WorldCommandJson" as X1
  component "SessionReplay" as X2
}

package "L11 Executor（把求解结果落到世界）" as L11 {
  component "OrderExecutor / SolverStepApplier / GreedyPlanBuilder" as E1
  component "JarSelector + 策略实现 / WorkshopStageResult" as E2
}

package "L12 World（世界总线与统一逻辑时间）" as L12 {
  component "WorldBus（信号 → 反应器 → 本 tick 效果队列）" as W1
  component "WorldSignal / WorldSignalKind / IWorldObserver / IWorldReactor / IWorldEffectSink" as W2
  component "WorldTime / WorldTimeState（Tick 委托 LogicalClock）" as W3
  component "FeasibilityInvalidationReactor（首个真实反应器）" as W4
}

package "L13 Bootstrap（装配）" as L13 {
  component "SystemBootstrapper" as B1
}

component "门面 JarSystem（实现 Rules.IWorldFacts）" as Facade

' ---- 层间依赖：只画跨层的主要方向；同层内部关系见图 12 ----
L1 --> L0
L2 --> L1
L3 --> L2
L3 --> L1 : 规则读取经 RuleContext
L4 --> L1
L5 --> L2
L6 --> L1
L6 --> L2
L7 --> L2
L7 --> L5
L7 --> L6
L8 --> L2
L8 --> L7 : IOrderExecutionCompletion
L9 --> L7
L9 --> L8
L9 --> L11
L10 --> L9
L11 --> L5
L11 --> L7
L12 --> L2
L12 --> L8 : ITickHandler
L13 --> L1
L13 --> L4
L13 --> L8
L13 --> L9
L13 --> L12
Facade --> L9
Facade --> L11
Facade --> L12
Facade --> L13

note as NLayerRule
  **层序是机器检查的，不是约定**
  `test/JarSystem.Tests/ArchitectureTests.cs`
  · `CoreLayersOnlyDependDownward`：一条 using 指向上层即红，报「文件:行号 + 双方排位」
  · `EveryNamespaceIsRanked`：新增命名空间未登记层号即红
  反向验证做过：往 `Config/Constants.cs` 里插一行 `using JarSystem.Core.Bootstrap;`，测试立刻红。

  本轮把**双向环 7 → 0**，所以旧图里的两条「味道」（Domain→Services、
  Abstractions↔Solver/Orders）**都已消失**，不要再照旧图讨论它们。
end note

note as NMoved
  **2026-09 之后搬过家的类型（旧图仍在旧位置，以本图为准）**
  · `IIdGenerator / SequentialIdGenerator / DefaultIdGenerators`：Services → **Domain**
  · `Requirement / JarState / SolverResult / WorkshopInfo / SolverStats…`：Solver·Orders → **Abstractions**
  · `ICommandJournal / LogError / ConsoleSystemLog`：Services → **Abstractions**
  · `RuleContext / ModifierStack / 5 种 Modifier / IIntensitySource`：Rules → **Domain**
  · `IProcessStepPrimitives` → **Orders**；`JarStateMapper` → **Orders/Feasibility**
end note

@enduml
