@startuml
' ============================================================
'  P5 收口后新增（2026-10-16）：规则层与过程系统的类图（聚焦，不重复 02_ClassDiagram 的 Core 全量）。
'  与代码对齐：src/JarSystem.Core/Rules/* 与 src/JarSystem.Core/Process/**。
'  PlantUML 约定（见 UML.txt）：起始标记保持裸形式（不带图名）；先声明后引用（否则会在引用处生成幽灵盒子）；
'  成员一行一个；成员名不以数字开头；只用单 token 的 stereotype。
' ============================================================

title 规则与过程系统（类图）

package "Rules（世界规则）" {
  class RuleContext {
    +Capability : WorkshopCapability
    +Stack : ModifierStack
    +IsBaseMarked(shape) : bool
    +IsAdditionalMarked(shape) : bool
    +IsBanned(liquid) : bool
    +GetPossibleTransforms(shape) : List
    +SuppressionReason(op, shape, liquid) : string
  }

  interface IRuleModifier {
    +Name : string
    +Kind : ModifierKind
    +Source : string
    +Priority : int
    +Window : (int, int)
  }

  class ModifierStack {
    +IsEmpty : bool
    +Active : IReadOnlyList
    +Push(modifier) : ModifierScope
    +Expire(tick) : int
    +SuppressionReason(op, shape, liquid) : string
    +TicksPerStepOverride(kind) : int
    +GrantedShapes() : IReadOnlyList
    +ApplyIntensity(target, value) : int
    +RequiredViolation() : string
  }

  class ModifierAwareSolver {
    +BeginCheck(nodeBudget)
    +Solve(reqs, info, jars, liquids, budget) : SolverResult
    +BudgetExceeded : bool
    +InconclusiveReason : string
  }

  class WorldQuery {
    +Workshop : string
    +What : string
    +Shape : string
    +Liquid : string
    +Empty : bool
    +Op : string
    +Value : int
    +Validate(errors, where)
    +Evaluate(facts, reason) : string
  }

  interface IWorldFacts {
    +WorkshopJars(workshop, shape, empty) : int
    +WorkshopLiquid(workshop, liquid) : int
    +WarehouseJars() : int
    +WarehouseLiquid(liquid) : int
    +DiscardedJars() : int
    +DiscardedLiquid(liquid) : int
  }

  class ScenarioOptions {
    +Name : string
    +InitialModifiers : List
    +Events : List
    +Validate() : ScenarioValidationResult
  }

  class ScenarioBinder {
    +Bind(data, world) : IRuleModifier
    +BindInitial(scenario, world) : List
    +CreateEventSource(scenario, stack, world) : IWorldEventSource
  }

  interface IWorldEventSource {
    +DrainForTick(tick) : IReadOnlyList
  }
}

package "Process（过程系统）" {
  class ProcessDefinition {
    +Kind : string
    +Subject : string
    +SubjectId : int
    +Priority : int
    +DeadlineTicks : int
    +GraceTicks : int
    +TicksPerStep : int
  }

  class ProcessInstance {
    +Id : int
    +State : ProcessState
    +Outcome : ProcessOutcome
    +AppliedSteps : int
    +AdvancedUnits : int
    +NextUnitTick : int
    +DeadlineTick : int
    +BlockedReason : string
    +LastJournalSeq : int
  }

  class ProcessRun {
    +Instance : ProcessInstance
    +SetPlan(source, declaredSteps)
    +StepApplied(operation, jarId, summary)
    +Milestone(name, summary)
    +NoteBlocked(reason)
    +NoteResumed()
    +NoteGraceExpired(reason)
    +Finish(success, reason)
    +Abort(reason)
  }

  class ProcessSystem {
    +Clock : LogicalClock
    +Pipeline : TickPipeline
    +Allocator : StepAllocator
    +Modifiers : ModifierStack
    +EventSource : IWorldEventSource
    +Observer : IProcessObserver
    +Begin(definition) : ProcessRun
    +ActiveProcesses : IReadOnlyList
    +Cancel(processId, reason)
  }

  class LogicalClock {
    +Tick : int
  }

  class TickPipeline {
    +Tick : int
    +AdvanceOneTick()
  }

  class StepAllocator {
    +TicksPerStep : int
    +For(kind) : int
  }

  class ProcessJournal {
    +Entries : IReadOnlyList
    +Count : int
    +DroppedEntries : int
    +Append(tick, processId, kind, ...) : JournalEntry
  }

  class OrderExecutionSession {
    +Stage : OrderExecutionStage
    +Succeeded : bool
    +Reason : string
    +AdvanceOneUnit(recorder) : bool
    +NextUnitTarget() : (string, string, string)
    +RemainingJarIds() : IEnumerable
  }

  interface IProcessAdvancer {
    +AdvanceOneUnit(recorder) : bool
    +CheckGuard() : GuardResult
    +MarkFailed(reason)
    +OnFinished()
  }

  interface IProcessObserver {
    +OnChanged(instance, reason, tick)
  }

  interface IOrderExecutionCompletion {
    +Complete(session) : (bool, string, object, bool, List)
  }
}

package "Abstractions（P3c/P4c 新增的端口）" {
  interface IProcessRecorder {
    +SetPlan(source, declaredSteps)
    +StepApplied(operation, jarId, summary)
    +Milestone(name, summary)
  }
  interface IProcessStepPrimitives {
    +ApplyPlannedStep(workshop, step, phase, recorder)
    +RunGreedyStage(workshop, reqs, phase, ev, recorder)
  }
  interface IIntensitySource {
    +Apply(target, value) : int
  }
  interface IWorkBudgetedSolver {
    +BeginCheck(nodeBudget)
    +BudgetExceeded : bool
    +InconclusiveReason : string
  }
}

package "内核侧实现（实现上列端口）" {
  class OrderExecutor {
    +Execute(order, master, slave, ev, solverPath, recorder)
    +BeginSession(order, master, slave, ev, solverPath, recorder)
  }
  class OrderService {
    +BeginOrderExecution(index, recorder)
    +CompleteOrderExecution(session)
  }
  class OrderProcessAdvancer {
    +AdvanceOneUnit(recorder) : bool
    +CheckGuard() : GuardResult
    +MarkFailed(reason)
    +OnFinished()
  }
}

' ---- 关系（两端都已声明，避免幽灵盒子）----
IProcessStepPrimitives <|.. OrderExecutor
IOrderExecutionCompletion <|.. OrderService
IProcessAdvancer <|.. OrderProcessAdvancer
OrderProcessAdvancer --> OrderExecutionSession
OrderProcessAdvancer --> IOrderExecutionCompletion
OrderExecutionSession --> IProcessRecorder
RuleContext --> ModifierStack
ModifierStack --> IRuleModifier
ModifierAwareSolver --> ModifierStack
ModifierAwareSolver ..> IWorkBudgetedSolver
WorldQuery --> IWorldFacts
ScenarioBinder --> IRuleModifier
ScenarioBinder --> IWorldEventSource
ScenarioBinder --> WorldQuery
ScenarioOptions --> ScenarioBinder

ProcessSystem --> LogicalClock
ProcessSystem --> TickPipeline
ProcessSystem --> StepAllocator
ProcessSystem --> ProcessJournal
ProcessSystem --> IProcessAdvancer
ProcessSystem --> IProcessObserver
ProcessSystem --> ProcessRun
ProcessRun --> ProcessInstance
ProcessRun --> ProcessJournal
ProcessInstance --> ProcessDefinition
ProcessSystem --> ModifierStack
ProcessSystem --> IWorldEventSource
OrderExecutionSession --> IProcessStepPrimitives
note as NPorts
  **端口归属（谁实现谁，决定依赖方向）**
  · IProcessStepPrimitives 由 OrderExecutor 实现（Executor 到 Abstractions）
  · IOrderExecutionCompletion 由 OrderService 实现（Services 到 Process）
  · IProcessRecorder 由 ProcessRun 实现（内核只认这个抽象）
  · IIntensitySource 由 ModifierStack 实现（产出层不必认识 Rules）
  · IWorkBudgetedSolver 由 StateSpaceSolver 与 ModifierAwareSolver 实现
end note

note as NScope
  **本图刻意不含**：Core 的既有类型（Jar/Workshop/Order/Solver…）——
  它们仍在 02_ClassDiagram 里；本图只画 P0-P5 新增的规则层与过程系统。
end note
@enduml
