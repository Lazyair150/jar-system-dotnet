@startuml
!theme plain
skinparam classFontSize 12

package "Config" {
  class Constants {
    {static} +SHAPES : String[]
    {static} +LIQUIDS : String[]
    {static} +DEFAULT_MAX_JARS : int = 20
    {static} +DEFAULT_MAX_LIQUIDS : int = 30
    {static} +WAREHOUSE_MAX_JARS : int = 200
    {static} +WAREHOUSE_MAX_LIQUIDS : int = 200
  }

  class ShapeRules {
    {static} +GetPossibleTransforms(baseMarks, addMarks, shape) : List
  }

  ' S2：形状/液体目录的唯一权威（默认 = 上面的常量）
  class Vocabulary {
    + Shapes : IReadOnlyList
    + Liquids : IReadOnlyList
    + IsValidShape(shape) : bool
    + IsValidLiquid(liquid) : bool
    {static} + Default : Vocabulary
  }

  ' S3：世界即数据（内容 + 参数），默认逐值等价于重构前的硬编码世界
  class WorldOptions {
    + Shapes / Liquids : List
    + DefaultMaxJars / DefaultMaxLiquids : int
    + Flow : FlowOptions
    + InitialStock : Map
    + Producers : List
    + Workshops : List
    + NamePools : NamePoolOptions
    + BuildVocabulary() : Vocabulary
    + Validate() : WorldValidationResult
    {static} + Default : WorldOptions
  }
  class FlowOptions {
    + JarCount / LiquidAmount : int
    + LiquidRate : Map
  }
  class ProducerOptions {
    + Name : String
    + Rates : Map
  }
  class WorkshopOptions {
    + Name : String
    + BaseMarks / AdditionalMarks / Ban : List
    + MaxJars / MaxLiquids : int?
  }
  class NamePoolOptions {
    + Prefix / Suffix : List
  }
  class WorldValidationResult {
    + Errors : List
    + Warnings : List
    + IsValid : bool
  }
  class WorldOptionsJson {
    {static} +FromJson(json) : WorldOptions
    {static} +ToJson(world) : String
  }

  WorkshopCapability ..> ShapeRules : delegates
  WorldOptions ..> Vocabulary : BuildVocabulary()
  WorldOptions *-- FlowOptions
  WorldOptions *-- "0..*" ProducerOptions
  WorldOptions *-- "0..*" WorkshopOptions
  WorldOptions *-- NamePoolOptions
  WorldOptions ..> WorldValidationResult : Validate()
  WorldOptionsJson ..> WorldOptions : 解析/导出（只处理字符串，不做 IO）
}

package "Domain" {
  class Jar {
    - Id : Integer?
    - Shape : String
    - Liquid : String?
    - IsMarked : Boolean
    {static} +NextId() : int
    + IsEmpty() : Boolean
    + IsFull() : Boolean
    + GetDescription() : String
    + Clone() : Jar
    + Mark() : void
    + ClearLiquid() : String?
    + PourIn(liquid) : void
    + Reshape(newShape) : void
  }

  class Workshop {
    - Name : String
    - Capability : WorkshopCapability   ' S1：能力参数（标记/禁令）只有这一处存储
    - MaxJars : int
    - MaxLiquids : int
    - Jars : List
    - LiquidStorage : Map
    - TemporaryAdditionalMarks : List  ' Case2 作用域内的运行时状态（不属于能力参数）
    + BaseMarks / AdditionalMarks / Ban : IReadOnlyList  ' 只读委托视图（等价于 Capability.*）
    + IsBanned(l) : bool
    + IsBaseMarked(s) / IsAdditionalMarked(s) : bool
    + HasJarCapacity() : bool
    + AddJar(jar) : bool
    + RemoveJar(jar) : Jar
    + PourIn(jar, liquid) : Result
    + PourOut(jar) : Result
    + ReshapeEmpty(jar, to, cost) : Result
    + ReshapeFull(jar, to) : Result
    + CanTransform(from, to) : bool
    + GetPossibleTransforms(shape) : List
    ' S1：更换能力（换规则参数，不动罐子/液体；资源搬迁是 SetMaster 切换事件的职责）
    + ReplaceCapability(capability) : void
    + WithTemporaryAdditionalMarks(shapes) : IDisposable
    + CreateSnapshot() : Snapshot
    + RestoreFromSnapshot(s) : void
    + TransferOut(jar) : Jar
    + TransferIn(jar) : bool
  }

  ' S1：不可变能力参数 —— 配置 → 工作台 → 快照 → 求解器 共用同一份（零拷贝）
  class WorkshopCapability {
    + BaseMarks / AdditionalMarks / Ban : IReadOnlyList
    + IsBaseMarked(s) / IsAdditionalMarked(s) : bool
    + IsBanned(liquid) : bool
    + GetPossibleTransforms(shape, extraAdditionalMarks) : List
    + CanTransform(from, to, extraAdditionalMarks) : bool
  }
  Workshop *-- WorkshopCapability : holds
}

package "Orders" {
  class Order {
    - Id : int
    - Requirements : List
    - Type : String
    - Status : String
    - FeasibilityResult : FRData
    + IsSatisfiedBy(jars) : bool
    - ValidateOrder() : void
  }

  class OrderEvent {
    - Order : Order
    - Master : Workshop
    - Slave : Workshop
    - CurrentPhase : String
    - TransferOccurred : bool
    - ExecutionLog : List
    + Warehouse : ProducerModule
    + Start() : bool
    + ExecuteCommand(cmd, ws) : Result
    + AdvanceToSlavePhase() : Result
    + Deliver() : Result
    + Fail(reason) : Result
    + RollbackSlaveToMaster() : void
  }

  ' 阶段 3-D：路径步骤由弱类型 Map 改为强类型 DTO（14 个 [JsonPropertyName] = 对外契约）
  class SolverStepDto {
    + Step : int
    + Requirement / Operation / Type : String
    + JarIndex / JarId : int?
    + JarShape / JarLiquid : String
    + TargetShape / TargetLiquid / CostLiquid / ReshapeMode : String
    + Consumed : Map<String,int>
    + JarsAfter : List<String>
  }

  ' 批 P4-a：autoCheckResults 的元素（原先是 List<object> 里的匿名对象）
  class AutoCheckResultDto {
    + Index : int
    + OrderId : int
    + Result : FRData
  }

  class FeasibilityChecker {
    - checks : IFeasibilityCheck[]
    + Solver : ISolver
    + Check(order, masterSnap, slaveSnap) : FRData
  }

  class WorkshopSwitchEvent {
    - OldMaster : Workshop
    - NewMaster : Workshop
    - CaseType : String
    - Operations : List
    + Execute() : (bool, Error)
    - ExecuteCase1() : void
    - ExecuteCase2() : void
    - TransferAll() : void
  }
}

package "Solver" {
  class StateSpaceSolver {
    - Stats : SolverStats
    - BestPartialPath : List
    + Solve(reqs, info, jars, liq) : SolverResult
    - Bt(reqs, idx, state, path) : List
    - GenOps(req, state) : List
    - FullOps(shape, liquid, state, ops) : void
    - EmptyOps(shape, state, ops) : void
    - Apply(op, state) : bool
    - Block(reqs, state) : String
  }

  class WorkshopInfo {
    - BaseMarks : List
    - AdditionalMarks : List
    - Ban : List
    - MaxLiquids : int
    + GetPossibleTransforms(shape) : List
  }
}

package "Executor" {
  enum JarSelectionStrategy {
    FIFO
    LIFO
    RareShapeFirst
    Random
  }

  class OrderExecutor {
    + SelectionStrategy : JarSelectionStrategy
    + Execute(order, master, slave, event, path) : Result
    - ExecuteTypeA() : Result
    - ExecuteTypeB() : Result
    - ExecuteViaSolverPath() : Result
  }

  ' SolverPathAdapter 已于阶段 3-D 废弃并删除（其职责由 SolverStepDto 的强类型属性取代）

  class SolverStepApplier {
    + Apply(ws, step : SolverStepDto, phase) : Result
  }

  class GreedyPlanBuilder {
    + ExecuteOn(ws, reqs, loc, event) : WorkshopStageResult
    - TryFull(req, ws, loc, event) : Result
    - TryEmpty(req, ws, loc, event) : Result
  }

  class JarSelector {
    + Strategy : JarSelectionStrategy
    + Select(jars, pred) : Jar
  }
}

package "Commands" {
  class PourInCommand {
    + Jar : Jar
    + Liquid : String
  }
  class ReshapeEmptyCommand {
    + Jar : Jar
    + TargetShape : String
    + CostLiquid : String
  }
  class PourOutCommand {
    + Jar : Jar
    + Workshop : Workshop
  }
  class TransferCommand {
    + Jar : Jar
    + FromWS : Workshop
    + ToWS : Workshop
  }
  class CommandExecutor {
    + History : List
    + Execute(cmd, ws, event) : CommandResult
    + ExecuteBatch(cmds, ws, event) : (bool,int,Reason)
    + Rollback(cmds, ws, event) : void
  }
}

package "Production" {
  class ProducerModule {
    + Warehouse : List
    + LiquidWarehouse : Map
    + DiscardedJars : int
    + DiscardedLiquids : Map
    + Tick(count) : void
    + ProduceLiquid(liquid, amount) : void
    + FlowToMaster(ws, jarCount, liqAmount) : void
  }
}

class JarSystem {
  + Workshops : IReadOnlyList
  + Orders : IReadOnlyList
  + ProducerModule : ProducerModule
  + CurrentMaster : Integer?
  + CurrentSlave : Integer?
  + AutoCheckEnabled : bool
  + EventHistory : IReadOnlyList
  + Log : ISystemLog
  + Rng : Random  ' internal（批 T4：整条随机链共用，可复现）
  + AddWorkshop(ws) : void
  + ClearWorkshops() : void
  + AddOrder(o) : void
  + ClearOrders() : void
  + SetMasterIndex(i) : void
  + SetSlaveIndex(i) : void
  + ResetProducerModule() : void
  + SetLiquidProductionRate(l, r) : void
  + SetFlowSettings(j, l) : void
  + CreateWorkshop(name, base, add, ban) : void
  + CreateOrder(reqs, type) : Result
  + SetMaster(index) : Dictionary
  + SetSlave(index) : Dictionary
  + CheckFeasibility(orderIndex) : FRData
  + ExecuteOrder(orderIndex) : Result
  + Tick(count) : int
  + UpdateWorkshopCapacity(index, jars, liq) : Object
  + GetState() : StateDto
  + Reset() : void
}

JarSystem --> "1" ProducerModule
JarSystem --> "1" FeasibilityChecker
JarSystem --> "1" OrderExecutor
JarSystem --> "*" Workshop
JarSystem --> "*" Order
JarSystem ..> WorkshopSwitchEvent : creates

FeasibilityChecker --> "1" StateSpaceSolver : ISolver
Order --> FeasibilityResultData
FeasibilityResultData *-- SolverStepDto : solverPath / masterPath
OrderEvent --> Order
OrderEvent --> Workshop
OrderEvent --> CommandExecutor : owns
OrderExecutor --> JarSelector : strategy
JarSelector ..> JarSelectionStrategy : maps
OrderExecutor --> SolverStepApplier
OrderExecutor --> GreedyPlanBuilder
GreedyPlanBuilder --> JarSelector
SolverStepApplier ..> SolverStepDto : 直接读强类型属性
Workshop --> "*" Jar

Workshop ..> ShapeRules : delegates
WorkshopInfo ..> ShapeRules : delegates

' ============================================================
' 2026-08 重构新增：接口（Abstractions）与服务（Services）
' 说明：本块为阶段 1-3 重构引入的接口与协作者，便于对照实现类。
' ============================================================
package "Abstractions（接口：依赖倒置）" {
  interface ISolver
  interface IIdGenerator
  interface IJarSelectionStrategy
  interface ISystemLog
  interface IWebSocketSink
}

package "Services（门面用例）" {
  class WorkshopService
  class OrderService
  class ProductionService
  class StateSerializer
  class StateDto
  class ConsoleSystemLog {
    + Error(message, ex) : void
    + Info(message) : void
  }

  ' 批 P4-a：producerStatus 由 Dictionary<string,object> 投影为强类型（前端 canvas.js/app.js 消费）
  class ProducerStatusDto {
    + Producers : List<ProducerInfoDto>
    + Generators : List<GeneratorStatusDto>
    + Warehouse : ProducerWarehouseDto
  }
  class ProducerInfoDto {
    + Name : String
    + Rates : Map<String,double>
  }
  class GeneratorStatusDto {
    + Shape : String
    + Rate / Accumulated : double
    + Producers : int
  }
  class ProducerWarehouseDto {
    + Jars : int
    + Liquids : Map<String,int>
  }
}

package "Feasibility（可行性内部协作）" {
  interface IFeasibilityCheck
  class SinglePhaseCheck
  class SlaveOnlyCheck
  class PartitionCheck
  class PartitionSearch
  class FeasibilityContext
  class FeasibilityResultFactory
  class PathSummaryFormatter
}

package "Switching（切换事件内部协作）" {
  interface ISwitchCase
  class SameBansCase
  class DifferentBansCase
  class JarValuePolicy
  class ResourceTransferrer
  class SwitchOperationLog
}

FeasibilityChecker --> IFeasibilityCheck : chain
SinglePhaseCheck ..|> IFeasibilityCheck
SlaveOnlyCheck ..|> IFeasibilityCheck
PartitionCheck ..|> IFeasibilityCheck
PartitionCheck --> PartitionSearch
FeasibilityChecker --> FeasibilityContext
FeasibilityChecker --> FeasibilityResultFactory
FeasibilityResultFactory --> PathSummaryFormatter
PathSummaryFormatter ..> SolverStepDto : 产出（阶段 3-D）
PartitionSearch --> ISolver
StateSpaceSolver ..|> ISolver
WorkshopSwitchEvent --> ISwitchCase : selects
SameBansCase ..|> ISwitchCase
DifferentBansCase ..|> ISwitchCase
WorkshopSwitchEvent --> ResourceTransferrer
ResourceTransferrer --> JarValuePolicy
Workshop ..> IIdGenerator : ids
Order ..> IIdGenerator : ids
OrderExecutor ..> IJarSelectionStrategy : uses
JarSystem --> WorkshopService
JarSystem --> OrderService
JarSystem --> ProductionService
JarSystem --> StateSerializer
StateSerializer --> StateDto : projects
ConsoleSystemLog ..|> ISystemLog
JarSystem --> ISystemLog : Log（批 A 接线）
CommandExecutor ..> ISystemLog : 回滚失败留痕

' ---- 批 P4-a：命令/消息契约强类型化 ----
StateDto *-- ProducerStatusDto : producerStatus
ProducerStatusDto *-- "0..*" ProducerInfoDto : producers
ProducerStatusDto *-- "0..*" GeneratorStatusDto : generators
ProducerStatusDto *-- ProducerWarehouseDto : warehouse
OrderService ..> AutoCheckResultDto : CheckAllFeasibility()
AutoCheckResultDto --> FeasibilityResultData : result
FeasibilityResultData *-- "0..*" SolverStepDto : solverPath / masterPath
FeasibilityResultData --> "0..*" DirectMatch : directSatisfactions
FeasibilityResultData --> "0..*" OperationNeed : operationsNeeded

' 批 T4：随机源注入（随机策略/随机订单/随机工作台共用同一条可复现链）
JarSystem ..> OrderExecutor : new OrderExecutor(Rng)
OrderExecutor ..> JarSelector : new JarSelector(rng)
JarSelector ..> RandomJarSelection : injects Random

' ---- S1：能力参数只有一份（配置 → 工作台 → 快照 → 求解器 零拷贝）----
WorkshopSnapshot *-- WorkshopCapability : holds
WorkshopInfo --> WorkshopCapability : reuses（求解器与领域层同源）
WorkshopInfoFactory ..> WorkshopInfo : From(snapshot)
FeasibilityResultData ..> SolverStepDto

' ---- S2：词表（形状/液体目录的唯一权威）----
Jar ..> Vocabulary : 形状校验（构造/改形，随实例携带）
Workshop ..> Vocabulary : 液体账目建键与键序
ProducerModule ..> Vocabulary : 生产线建立 / Tick 遍历 / 罐子创建
Order ..> Vocabulary : 需求校验
JarSystem --> Vocabulary

' ---- S3：世界即数据（默认 = 重构前的硬编码世界）----
JarSystem --> WorldOptions : World（流入/速率/装配都来自它）
SystemBootstrapper ..> WorldOptions : 按配置装配世界
SystemBootstrapper ..> Vocabulary : 传入词表
WorldOptions ..> Rules : Default 复用内置模板
WorldOptionsJson ..> WorldOptions : 宿主负责读写文件（核心只做字符串解析）

@enduml
