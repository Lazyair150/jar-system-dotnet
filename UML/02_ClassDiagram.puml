@startuml
title Jar System 核心类图（JarSystem.Core）
' ============================================================
'  2026-09-16 全量重写：逐个类型读源码核对，不采用任何历史结论。
'  覆盖 Core 全部命名空间与类型；私有辅助成员从略（在 note 里点名）。
'  契约键名用 (json: xxx) 标注 —— 括号里的就是对外 JSON 键，已按源码原样抄录。
' ============================================================
skinparam classAttributeIconSize 0
skinparam classFontSize 11
hide empty members

package "Config" {
  class Constants {
    {static} +SHAPES : IReadOnlyList 8 项
    {static} +LIQUIDS : IReadOnlyList 2 项
    {static} +DEFAULT_MAX_JARS = 20
    {static} +DEFAULT_MAX_LIQUIDS = 30
    {static} +WAREHOUSE_MAX_JARS = 200
    {static} +WAREHOUSE_MAX_LIQUIDS = 200
    {static} +MAX_ORDER_REQUIREMENTS = 10
    {static} +MAX_PRODUCER_RATE = 100
  }
  class "Constants.OrderType" as CT_OrderType {
    +A = "A"
    +B = "B"
  }
  class "Constants.OrderStatus" as CT_OrderStatus {
    +PENDING = "待执行"
    +EXECUTING = "执行中"
    +SUCCESS = "成功"
    +FAILED = "失败"
  }
  class "Constants.OperationType" as CT_OpType {
    +POUR_IN = "倒液"
    +POUR_OUT = "倒出"
    +RESHAPE_EMPTY = "改形(空罐)"
    +RESHAPE_FULL = "改形(满罐)"
    +TRANSFER = "转移"
  }
  class "Constants.OrderPhase" as CT_Phase {
    +NONE = "none"
    +MASTER = "master"
    +SLAVE = "slave"
  }
  class "Constants.CheckMethod" as CT_CheckMethod {
    +SINGLE_PHASE = "single_phase"
    +SLAVE_ONLY = "slave_only"
    +PARTITION = "partition"
  }
  class "Constants.SwitchCaseType" as CT_SwitchCase {
    +SAME_BANS = "same_bans"
    +DIFFERENT_BANS = "different_bans"
  }

  class ShapeRules <<static>> {
    {static} +GetPossibleTransforms(baseMarks, addMarks, shape) : List
  }
  class Rules <<static>> {
    {static} +WORKSHOP_TEMPLATES : WorkshopTemplate 共 2 项
  }
  class WorkshopTemplate {
    +Name : string
    +BaseMarks : IReadOnlyList
    +AdditionalMarks : IReadOnlyList
    +Ban : IReadOnlyList
  }
  class Vocabulary {
    +Shapes : IReadOnlyList
    +Liquids : IReadOnlyList
    +IsValidShape(s) : bool
    +IsValidLiquid(l) : bool
    {static} +Default : Vocabulary
  }
  class WorldOptions {
    +Shapes (json: shapes)
    +Liquids (json: liquids)
    +DefaultMaxJars (json: defaultMaxJars)
    +DefaultMaxLiquids (json: defaultMaxLiquids)
    +Flow (json: flow) : FlowOptions
    +InitialStock (json: initialStock) : Map
    +Producers (json: producers) : List
    +Workshops (json: workshops) : List
    +NamePools (json: namePools) : NamePoolOptions
    +BuildVocabulary() : Vocabulary
    +Validate() : WorldValidationResult
    {static} +Default : WorldOptions
  }
  class FlowOptions {
    +JarCount (json: jarCount)
    +LiquidAmount (json: liquidAmount)
    +LiquidRate (json: liquidRate) : Map
  }
  class ProducerOptions {
    +Name (json: name)
    +Rates (json: rates) : Map
  }
  class WorkshopOptions {
    +Name (json: name)
    +BaseMarks (json: baseMarks)
    +AdditionalMarks (json: additionalMarks)
    +Ban (json: ban)
    +MaxJars (json: maxJars) : int?
    +MaxLiquids (json: maxLiquids) : int?
  }
  class NamePoolOptions {
    +Prefix (json: prefix)
    +Suffix (json: suffix)
  }
  class WorldValidationResult {
    +Errors : List
    +Warnings : List
    +IsValid : bool
  }
  class WorldOptionsJson <<static>> {
    {static} +FromJson(json) : WorldOptions
    {static} +ToJson(world) : string
  }

  Constants ..> CT_OrderType
  Constants ..> CT_OrderStatus
  Constants ..> CT_OpType
  Constants ..> CT_Phase
  Constants ..> CT_CheckMethod
  Constants ..> CT_SwitchCase
  Rules *-- WorkshopTemplate
  WorldOptions *-- FlowOptions
  WorldOptions *-- "0..*" ProducerOptions
  WorldOptions *-- "0..*" WorkshopOptions
  WorldOptions *-- NamePoolOptions
  WorldOptions ..> WorldValidationResult : Validate()
  WorldOptions ..> Vocabulary : BuildVocabulary()
  WorldOptions ..> Rules : Default 复用内置模板
  WorldOptionsJson ..> WorldOptions
  Vocabulary ..> Constants : Default 取自常量
}

package "Domain" {
  class Jar {
    +Id : int?  (internal set)
    +Shape : string  (private set)
    +Liquid : string?  (private set)
    +IsMarked : bool  (private set)
    +IsEmpty() : bool
    +IsFull() : bool
    +GetDescription() : string
    ~Mark()
    ~Unmark()
    ~PourIn(liquid)
    ~ClearLiquid() : string?
    ~RestoreLiquid(liquid)
    ~Reshape(newShape)
    +DeepClone() : Jar
    {static} +IsValidShape(shape) : bool
    +IsValidShapeIn(shape) : bool
  }
  class Workshop {
    +Name : string
    +Capability : WorkshopCapability
    +BaseMarks : IReadOnlyList
    +AdditionalMarks : IReadOnlyList
    +Ban : IReadOnlyList
    +MaxJars : int  (private set)
    +MaxLiquids : int  (private set)
    +Jars : IReadOnlyList
    +LiquidStorage : IReadOnlyDictionary
    +ReplaceCapability(cap)
    +WithTemporaryAdditionalMarks(shapes) : IDisposable
    +IsBaseMarked(s) : bool
    +IsAdditionalMarked(s) : bool
    +IsBanned(l) : bool
    +GetPossibleTransforms(s) : List
    +CanTransform(from, to) : bool
    +HasJarCapacity() : bool
    +HasUsableLiquid(l) : bool
    +AddLiquid(l, n) : bool
    +RemoveLiquid(l, n) : bool
    +TryReceiveLiquid(l, amt) : int
    +DrainLiquid(l) : int
    +ResizeJarCapacity(n) : int
    +ResizeLiquidCapacity(n) : Map
    +AddJar(j) : bool
    +RemoveJar(j) : Jar?
    +TransferOut(j) : Jar?
    +TransferIn(j) : bool
    +ClearMarks()
    +PourIn(jar, liquid) : (bool, string?)
    +PourOut(jar) : (bool, string?, string?)
    +ReshapeEmpty(jar, to, cost) : (bool, string?)
    +ReshapeFull(jar, to) : (bool, string?)
    +CreateSnapshot() : WorkshopSnapshot
    +RestoreFromSnapshot(snap)
  }
  class TemporaryMarksScope <<nested>> {
    +Dispose()
  }
  class WorkshopCapability {
    +BaseMarks : IReadOnlyList
    +AdditionalMarks : IReadOnlyList
    +Ban : IReadOnlyList
    +IsBaseMarked(s) : bool
    +IsAdditionalMarked(s) : bool
    +IsBanned(liquid) : bool
    +GetPossibleTransforms(shape, extraMarks) : List
    +CanTransform(from, to, extraMarks) : bool
  }
  class WorkshopSnapshot {
    +Name : string
    +MaxJars : int
    +MaxLiquids : int
    +Capability : WorkshopCapability
    +BaseMarks : IReadOnlyList
    +AdditionalMarks : IReadOnlyList
    +Ban : IReadOnlyList
    +Jars : IReadOnlyList
    +Liquids : IReadOnlyDictionary
  }
  class DomainValidationException {
  }
  class InvalidOperationException <<dotnet>> {
  }

  Workshop *-- "1" WorkshopCapability
  Workshop o-- "0..*" Jar
  Workshop ..> WorkshopSnapshot : CreateSnapshot / RestoreFromSnapshot
  Workshop ..> TemporaryMarksScope : 创建
  TemporaryMarksScope --> Workshop
  WorkshopCapability ..> ShapeRules : delegates
  WorkshopSnapshot *-- WorkshopCapability : 复用同一份
  WorkshopSnapshot o-- "0..*" Jar
  Workshop ..> IIdGenerator : AddJar 时分配 Id
  Workshop ..> Vocabulary : 液体账目建键与键序
  Jar ..> Vocabulary : 形状校验（随实例携带）
  InvalidOperationException <|-- DomainValidationException
}

package "Orders" {
  class Order {
    +Id : int
    +Requirements : IReadOnlyList
    +Type : string
    +Status : string  (private set)
    +FeasibilityResult : FeasibilityResultData?  (private set)
    +MarkSucceeded()
    +MarkFailed()
    +RecordFeasibility(result)
    +IsSatisfiedBy(jars) : bool
  }
  class Requirement {
    +Shape : string  (init)
    +Liquid : string?  (init)
  }
  class FeasibilityResultData {
    +Feasible (json: feasible) : bool
    +Undetermined (json: undetermined) : bool
    +Blockage (json: blockage) : string?
    +Reason (json: reason) : string?
    +Timestamp (json: timestamp) : string?
    +DirectCount (json: directCount) : int
    +OperationCount (json: operationCount) : int
    +SolverPath (json: solverPath) : List
    +MasterPath (json: masterPath) : List
    +CheckMethod (json: checkMethod) : string?
    +TransferJarIds (json: transferJarIds) : List
    +TransferLiquids (json: transferLiquids) : Map
  }
  class SolverStep {
    +Step : int
    +Requirement : Requirement?
    +Operation : SolverOperation?
    +Before : List
    +After : List
    +AfterLiquids : Map
  }
  class SolverOperation {
    +Type : string?
    +Description : string?
    +JarIndex : int?
    +TargetShape : string?
    +TargetLiquid : string?
    +CostLiquid : string?
    +Consumed : Map
    +FullReshape : bool
  }
  class JarState {
    +Id : int?
    +Shape : string
    +Liquid : string?
    +IsMarked : bool
    +MasterOrigin : bool
    {static} +From(jar) : JarState
    {static} +Copy(src, masterOrigin) : JarState
  }
  class OrderEvent {
    +Order : Order
    +Master : Workshop
    +Slave : Workshop
    +Status : string  (private set)
    +MasterSnapshot : WorkshopSnapshot?  (private set)
    +SlaveSnapshot : WorkshopSnapshot?  (private set)
    +TransferOccurred : bool  (private set)
    +CurrentPhase : string  (private set)
    +ExecutionLog : IReadOnlyList
    +Errors : IReadOnlyList
    +DeliveredJars : IReadOnlyList
    +TransferredJarIds : IReadOnlyCollection
    +TransferredLiquids : IReadOnlyDictionary
    +SlaveOriginalJarIds : IReadOnlyCollection
    +Executor : CommandExecutor
    ~AppendLog(entry)
    ~AppendError(error)
    +Start() : bool
    +ExecuteCommand(cmd, ws) : CommandResult
    +ExecuteBatch(cmds, ws) : (bool, int, string?)
    +AdvanceToSlavePhase() : CommandResult
    +RecordTransfer(jar)
    +RecordLiquidTransfer(l, amt)
    +CheckDelivery() : (bool, string)
    +Deliver() : (bool, string?)
    +Fail(reason) : (bool, string?)
    +RollbackSlaveToMaster()
    +GetReport() : Map
  }
  class ExecutionLogEntry {
    +Phase : string?
    +Workshop : string?
    +Command : string?
    +Action : string?
    +Description : string?
    +Jar : string?
    +Liquid : string?
    +Amount : int?
    +Reason : string?
  }
  class LogError {
    +Phase : string?
    +Command : string?
    +Reason : string?
  }
  class SlaveRollback <<internal>> {
    +Execute(master, slave, transferredJarIds, slaveOriginalJarIds, transferredLiquids, appendLog)
  }
  class WorkshopSwitchEvent {
    +OldMaster : Workshop
    +NewMaster : Workshop
    +CaseType : string
    +Operations : IReadOnlyList
    +Execute() : (bool, string?)
  }
  class FeasibilityChecker {
    +Solver : ISolver
    +NodeBudget : int = 400000
    +Check(order, masterSnap, slaveSnap) : FeasibilityResultData
  }
  class SolverStepDto {
    +Step (json: step) : int
    +Requirement (json: requirement) : string?
    +Operation (json: operation) : string?
    +Type (json: type) : string?
    +JarIndex (json: jarIndex) : int?
    +JarId (json: jarId) : int?
    +JarShape (json: jarShape) : string?
    +JarLiquid (json: jarLiquid) : string?
    +TargetShape (json: targetShape) : string?
    +TargetLiquid (json: targetLiquid) : string?
    +CostLiquid (json: costLiquid) : string?
    +ReshapeMode (json: reshapeMode) : string?
    +Consumed (json: consumed) : Map
    +JarsAfter (json: jarsAfter) : List
  }
  class AutoCheckResultDto {
    +Index (json: index) : int
    +OrderId (json: orderId) : int
    +Result (json: result) : FeasibilityResultData?
  }

  Order *-- "0..*" Requirement
  Order --> FeasibilityResultData
  Order ..> JarMatcher : IsSatisfiedBy
  FeasibilityResultData *-- "0..*" SolverStepDto : solverPath / masterPath
  SolverStep --> SolverOperation
  SolverStep --> "0..*" JarState
  SolverStep --> Requirement
  OrderEvent --> Order
  OrderEvent --> "1" Workshop : master
  OrderEvent --> "1" Workshop : slave
  OrderEvent --> CommandExecutor : owns
  OrderEvent *-- "0..*" ExecutionLogEntry
  OrderEvent *-- "0..*" LogError
  OrderEvent --> "0..*" Jar : DeliveredJars
  OrderEvent ..> SlaveRollback : RollbackSlaveToMaster 一行委托
  SlaveRollback --> Workshop
  WorkshopSwitchEvent --> "2" Workshop
  WorkshopSwitchEvent --> ISwitchCase
  WorkshopSwitchEvent --> ResourceTransferrer
  FeasibilityChecker --> IFeasibilityCheck
  FeasibilityChecker --> ISolver
  AutoCheckResultDto --> FeasibilityResultData
}

package "Orders.Feasibility" {
  interface IFeasibilityCheck <<internal>> {
    +Method : string
    +TryCheck(ctx) : FeasibilityResultData?
  }
  class SinglePhaseCheck <<internal>> {
    +Method = single_phase
  }
  class SlaveOnlyCheck <<internal>> {
    +Method = slave_only
  }
  class PartitionCheck <<internal>> {
    +Method = partition
  }
  class PartitionSearch {
    +Search(req, lastBlockage, inconclusiveReason) : Outcome?
  }
  class PartitionSearchRequest {
    +Requirements : List
    +MasterInfo : WorkshopInfo
    +SlaveInfo : WorkshopInfo
    +MasterJars : List
    +MasterLiquids : Map
    +SlaveJars : List
    +SlaveLiquids : Map
  }
  class PartitionSearchOutcome {
    +MasterPath : List
    +SlavePath : List
    +TransferJarIds : List
    +TransferLiquids : Map
    +DirectCount : int
    +OperationCount : int
  }
  class FeasibilityContext <<internal>> {
    +Order : Order
    +Master : WorkshopSnapshot
    +Slave : WorkshopSnapshot
    +Solver : ISolver
    +Requirements : List
    +MasterInfo : WorkshopInfo
    +SlaveInfo : WorkshopInfo
  }
  class WorkshopInfoFactory <<internal>> {
    {static} +From(snap) : WorkshopInfo
  }
  class FeasibilityResultFactory <<internal>> {
    {static} +FromSolverResult(r, method) : FeasibilityResultData
    {static} +FromPath(path, method) : FeasibilityResultData
  }
  class PathSummaryFormatter <<internal>> {
    {static} +Summary(path) : List
  }
  class JarMatcher <<static>> {
    {static} +Matches(jar, req) : bool
    {static} +MatchAll(jars, reqs, matches) : int 数组
  }
  class LiquidRequirementCalculator <<static>> {
    {static} +ComputeRequired(path, slaveLiquids) : Map
  }
  class RequirementOrdering <<static>> {
    {static} +FullFirst(reqs) : List
  }

  SinglePhaseCheck ..|> IFeasibilityCheck
  SlaveOnlyCheck ..|> IFeasibilityCheck
  PartitionCheck ..|> IFeasibilityCheck
  PartitionCheck --> PartitionSearch
  PartitionSearch --> PartitionSearchRequest
  PartitionSearch --> PartitionSearchOutcome
  PartitionSearch --> ISolver
  PartitionSearch ..> JarMatcher
  PartitionSearch ..> LiquidRequirementCalculator
  FeasibilityChecker --> FeasibilityContext
  FeasibilityChecker --> FeasibilityResultFactory
  FeasibilityContext ..> WorkshopInfoFactory
  FeasibilityContext ..> RequirementOrdering
  FeasibilityResultFactory --> FeasibilityResultData
  FeasibilityResultFactory ..> PathSummaryFormatter
  PathSummaryFormatter ..> SolverStepDto
}

package "Orders.Switching" {
  class BanComparison <<internal>> {
    {static} +Same(a, b) : bool
  }
  interface ISwitchCase <<internal>> {
    +CaseType : string
    +Applies(oldMaster, newMaster) : bool
    +Execute(oldMaster, newMaster, log)
  }
  class SameBansCase <<internal>> {
    +CaseType = same_bans
  }
  class DifferentBansCase <<internal>> {
    +CaseType = different_bans
  }
  class ResourceTransferrer <<internal>> {
    +TransferAll(oldMaster, newMaster, log, caseType)
  }
  class JarValuePolicy <<internal>> {
    +ValueOf(jar) : int
  }
  class SwitchOperationLog <<internal>> {
    +Entries : IReadOnlyList
    +Add(action, description)
    +Clear()
  }
  class SwitchLogEntry {
    +Action : string
    +Description : string
  }

  SameBansCase ..|> ISwitchCase
  DifferentBansCase ..|> ISwitchCase
  SameBansCase ..> BanComparison
  DifferentBansCase ..> BanComparison
  DifferentBansCase ..> Workshop : WithTemporaryAdditionalMarks
  ResourceTransferrer --> JarValuePolicy
  ResourceTransferrer ..> Workshop
  ResourceTransferrer ..> SwitchOperationLog
  SwitchOperationLog *-- "0..*" SwitchLogEntry
}

package "Solver" {
  class StateSpaceSolver {
    +Stats : SolverStats
    +BestPartialPath : List
    +BudgetExceeded : bool
    {static} +DefaultNodeBudget = 400000
    +BeginCheck(nodeBudget)
    +Solve(reqs, info, jars, liquids, transferBudget) : SolverResult
  }
  class SolverState <<internal>> {
    +Jars : List
    +Liquids : Map
    +WorkshopInfo : WorkshopInfo
    +TransferBudget : int
    +TransferUsed : int
    +Clone() : SolverState
    +FindJarIndex(pred) : int
    +LiquidCount(l) : int
    +HasLiquid(l, a) : bool
    +ConsumeLiquid(l, a) : bool
    +AddLiquid(l, a)
    +MarkJar(i)
    +SetShape(i, s)
    +SetLiquid(i, l)
    +TakeLiquid(i) : string?
    +IsEmpty(j) : bool
    +IsBanned(l) : bool
    +CanTransform(f, t) : bool
    +AvailableCostLiquids(exclude) : List
  }
  class WorkshopInfo {
    +Capability : WorkshopCapability
    +MaxJars : int
    +MaxLiquids : int
    +GetPossibleTransforms(shape) : List
  }
  class SolverStats {
    +NodesExplored : int
    +SolutionsFound : int
    +DeadEnds : int
    +PourOuts : int
    +MemoHits : int
    +IsomorphicPruned : int
  }
  class SolverResult {
    +Feasible : bool
    +Path : List
    +Blockage : string?
    +Stats : SolverStats
    +BudgetExceeded : bool
    +FinalJars : List
    +FinalLiquids : Map
  }

  StateSpaceSolver ..|> ISolver
  StateSpaceSolver ..|> IWorkBudgetedSolver
  StateSpaceSolver *-- SolverStats
  StateSpaceSolver --> SolverResult
  StateSpaceSolver ..> SolverState : 内部搜索态
  SolverState --> WorkshopInfo
  SolverState --> "0..*" JarState
  SolverResult --> "0..*" SolverStep
  SolverResult --> "0..*" JarState : FinalJars
  WorkshopInfo *-- WorkshopCapability : 与域层同源
}

package "Executor" {
  enum JarSelectionStrategy {
    FIFO
    LIFO
    RareShapeFirst
    Random
  }
  class OrderExecutor {
    +SelectionStrategy : JarSelectionStrategy
    +Execute(order, master, slave, event, solverPath) : (bool, List, List, string?)
  }
  class SolverStepApplier <<internal>> {
    +Apply(w, step, phase) : (bool, ExecutionLogEntry?, string?)
  }
  class GreedyPlanBuilder <<internal>> {
    +ExecuteOn(w, reqs, loc, ev) : WorkshopStageResult
  }
  class JarSelector <<internal>> {
    +Strategy : JarSelectionStrategy = FIFO
    +Select(jars, predicate) : Jar?
  }
  class WorkshopStageResult <<internal>> {
    +Ops : List
    +Errs : List
  }

  OrderExecutor --> SolverStepApplier
  OrderExecutor --> GreedyPlanBuilder
  OrderExecutor --> JarSelector
  OrderExecutor ..> JarSelectionStrategy
  OrderExecutor ..> OrderEvent
  OrderExecutor ..> Order
  GreedyPlanBuilder --> JarSelector
  GreedyPlanBuilder ..> Workshop
  GreedyPlanBuilder ..> OrderEvent
  SolverStepApplier ..> SolverStepDto
  SolverStepApplier ..> Workshop
}

package "Executor.Strategies" {
  class FifoJarSelection <<internal>> {
    +Name = "FIFO"
  }
  class LifoJarSelection <<internal>> {
    +Name = "LIFO"
  }
  class RareShapeFirstJarSelection <<internal>> {
    +Name = "RareShapeFirst"
  }
  class RandomJarSelection <<internal>> {
    +Name = "Random"
  }
  class FirstMatchJarSelection <<internal>> {
    +Name = "FirstMatch"  (兜底)
  }
  FifoJarSelection ..|> IJarSelectionStrategy
  LifoJarSelection ..|> IJarSelectionStrategy
  RareShapeFirstJarSelection ..|> IJarSelectionStrategy
  RandomJarSelection ..|> IJarSelectionStrategy
  FirstMatchJarSelection ..|> IJarSelectionStrategy
  JarSelector o-- "0..*" IJarSelectionStrategy
}

package "Commands" {
  abstract class Command {
    +Type : string
    +Params : IReadOnlyDictionary
    +Executed : bool
    +Result : CommandResult?
    +Timestamp : long?
    +Execute(workshop, event) : CommandResult
    +Undo(workshop, event) : CommandResult
    +ToJson() : Map
  }
  class CommandResult {
    +Success : bool
    +Reason : string?
  }
  class PourInCommand {
    +Jar : Jar
    +Liquid : string
  }
  class ReshapeEmptyCommand {
    +Jar : Jar
    +TargetShape : string
    +CostLiquid : string
    +OriginalShape : string
  }
  class TransferCommand {
    +Jar : Jar
    +From : Workshop
    +To : Workshop
  }
  class PourOutCommand {
    +Jar : Jar
    +OwnerWorkshop : Workshop
    +OriginalLiquid : string
  }
  class CommandExecutor {
    +History : IReadOnlyList
    +Execute(cmd, ws, event) : CommandResult
    +ExecuteBatch(cmds, ws, event) : (bool, int, string?)
    +Rollback(cmds, ws, event)
    +Clear()
    +GetHistory() : List
  }

  PourInCommand --|> Command
  ReshapeEmptyCommand --|> Command
  TransferCommand --|> Command
  PourOutCommand --|> Command
  Command --> CommandResult
  CommandExecutor o-- "0..*" Command
  CommandExecutor ..> ISystemLog
  PourInCommand ..> Workshop
  ReshapeEmptyCommand ..> Workshop
  TransferCommand ..> Workshop
  PourOutCommand ..> Workshop
}

package "Production" {
  class ProducerModule {
    +Warehouse : Warehouse
    +Generators : IReadOnlyDictionary
    +Producers : IReadOnlyDictionary
    +LiquidWarehouse : IReadOnlyDictionary  (兼容转发)
    +RegisterProducer(name, rates) : Producer
    +RemoveProducer(name)
    +UpdateRate(name, shape, rate)
    +Tick(count) : List
  }
  class Warehouse {
    +Jars : IReadOnlyList
    +LiquidWarehouse : IReadOnlyDictionary
    +DiscardedLiquids : IReadOnlyDictionary
    +JarCount : int
    +DiscardedJars : int
    +StoreJars(jars)
    +ProduceLiquid(liquid, amount)
    +CountDiscardedJars(count)
    +CountDiscardedLiquids(liquid, count)
    +LiquidCount(liquid) : int
    +FlowToMaster(master, jarCount, liquidAmount) : (List, Map)
  }
  class Producer {
    +Name : string
    +Rates : IReadOnlyDictionary
    ~SetRate(shape, rate)
  }
  class ShapeProductionLine {
    +Shape : string
    +Producers : IReadOnlyList
    +Accumulated : double  (private set)
    +AddProducer(p)
    +RemoveProducer(name)
    +UpdateRate(name, rate)
    +Tick() : List
    +GetTotalRate() : double
  }

  ProducerModule *-- Warehouse
  ProducerModule *-- "0..*" Producer
  ProducerModule *-- "0..*" ShapeProductionLine
  ShapeProductionLine o-- "0..*" Producer
  Warehouse ..> Workshop : FlowToMaster
  Warehouse ..> Jar
  ProducerModule ..> Vocabulary
}

package "Services" {
  class StateSerializer <<internal>> {
    {static} +Snapshot(system) : StateDto
  }
  class StateDto {
    +Workshops (json: workshops) : List
    +Orders (json: orders) : List
    +Warehouse (json: warehouse) : WarehouseStateDto
    +ProducerStatus (json: producerStatus) : ProducerStatusDto
    +GlobalState (json: globalState) : GlobalStateDto
    +EventHistory (json: eventHistory) : List
  }
  class WorkshopStateDto {
    +Index (json: index) : int
    +Name (json: name) : string
    +BaseMarks (json: baseMarks)
    +AdditionalMarks (json: additionalMarks)
    +Ban (json: ban)
