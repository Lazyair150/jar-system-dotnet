# ============================================================
# jar-system-dotnet — .gitignore
# Ignore only reproducible build/cache/local artifacts.
# Keep contract baselines, schemas, fixtures and documentation tracked.
# ============================================================

# .NET build output
[Bb]in/
[Oo]bj/
.vs/
TestResults/
artifacts/
coverage/
*.user
*.suo
*.cache

# IDE/local tooling
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs and temporary diagnostics
*.log
*.tmp
*.bak
*.received.*
_test_diag.csx

# Verification/build outputs (regenerated)
重构报告/_verify_output.txt
重构报告/_build_output.txt
重构报告/_quality_output.txt

# Process journal exports (generated evidence; conclusions live in reports)
过程系统/_journal/

# Contract generated comparison outputs; committed baselines/schemas remain tracked
重构报告/_contract/state_keys.txt
重构报告/_contract/diff.txt
重构报告/_contract/state_keys_config.txt
重构报告/_contract/diff_config.txt

# Large pre-refactor snapshot duplicated by src/
重构报告/_backup/

# Approval test received files are transient; approved baselines remain tracked
test/JarSystem.Tests/Approvals/*.received.json

# Godot practice project unrelated to the jar system
文档归档/05_Godot练习工程/
